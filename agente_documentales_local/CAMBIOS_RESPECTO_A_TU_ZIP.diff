+def _bloques(d_partes):
+    n_final = int((leer_json(d_partes / "estructura.json", {}) or {}).get("n", len(SECCIONES)))
+    partes = sorted(d_partes.glob("parte_*.txt"), key=lambda p: _numero(p.name))
